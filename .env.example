# Copy to .env and fill in your own values. Never commit .env.

# Password required to access the content editor at /admin
VITE_ADMIN_PASSWORD=change-me

# Supabase connection (optional — falls back to the public anon key built into src/supabase.js)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
